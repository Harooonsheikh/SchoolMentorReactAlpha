function ServicePage({ title, sub, icon, features, image, ctaLabel = "Book a Free Demo", setPage }) {
  const go = (p) => { setPage(p); window.scrollTo({ top: 0, behavior: "smooth" }); };
  const sliderRef = useRef(null);
  const [activeIndex, setActiveIndex] = useState(0);
  const handleScroll = () => {
    const slider = sliderRef.current;
    if (!slider || !slider.children.length) return;
    const cardWidth = slider.children[0].offsetWidth + 16;
    const index = Math.round(slider.scrollLeft / cardWidth);
    setActiveIndex(Math.min(index, features.length - 1));
  };

  const goToSlide = (i) => {
    const slider = sliderRef.current;
    if (!slider || !slider.children.length) return;
    const cardWidth = slider.children[0].offsetWidth + 16;
    slider.scrollTo({ left: cardWidth * i, behavior: "smooth" });
    setActiveIndex(i);
  };

  return (
    <div className="page-enter">
      <style>{`
        .cards-grid-3 {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
        }

        @media (max-width: 768px) {
          .cards-grid-3 {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            gap: 16px;
            padding-bottom: 12px;
            scrollbar-width: none;
          }

          .cards-grid-3::-webkit-scrollbar {
            display: none;
          }

          .cards-grid-3 > * {
            flex: 0 0 80%;
            scroll-snap-align: start;
          }

          .slider-dots {
            display: flex !important;
          }
        }

        .slider-dots {
          display: none;
          justify-content: center;
          align-items: center;
          gap: 8px;
          margin-top: 16px;
        }

        .slider-dot {
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: #cbd5e1;
          border: none;
          padding: 0;
          cursor: pointer;
          transition: background 0.3s, transform 0.3s;
        }

        .slider-dot.active {
          background: #2563EB;
          transform: scale(1.3);
        }
      `}</style>

      {/* Hero Banner */}
      <div style={{ background: "linear-gradient(180deg, var(--sm-bg) 0%, var(--sm-surface) 60%)", padding: "clamp(40px,5vw,72px) clamp(30px,30px,50px)", position: "relative", overflow: "hidden" }}>
        <div data-sr-stagger style={{ maxWidth: CONTAINER, margin: "0 auto", position: "relative", zIndex: 1 }}>
          {icon && (
            <div data-sr style={{ display: "inline-flex", alignItems: "center", justifyContent: "center", width: 56, height: 56, borderRadius: 14, marginBottom: 18, fontSize: 24, color: "var(--sm-navy)", background: "var(--sm-teal-light)" }}>{icon}</div>
          )}
          <h1 data-sr style={{ ...s.sectionTitle(false), fontSize: "clamp(1.75rem,3.5vw,2.75rem)", marginBottom: 12 }}>{title}</h1>
          <p data-sr style={{ ...s.sectionSub(false), marginBottom: 24 }}>{sub}</p>
          <div data-sr><Btn variant="teal" size="lg" onClick={() => { openDemoForm(); }}>Book a Free Demo</Btn></div>
        </div>
      </div>

      {/* Image */}
      <div style={{ width: "100%", background: "var(--sm-surface)", overflow: "hidden", padding: "clamp(16px,4vw,60px)" }}>
        <div style={{ maxWidth: CONTAINER, margin: "0 auto" }}>
          <img data-sr="scale" src={image || smImage} alt={title || "School Mentor"} style={{ borderRadius: 16, width: "100%", display: "block", border: "1px solid var(--sm-border)", boxShadow: "0 30px 70px -24px var(--sm-shadow)" }} />
        </div>
      </div>

      {/* Features Grid / Mobile Slider */}
      <div style={s.section(false)}>
        <div style={s.sectionInner}>
          <div
            className="cards-grid-3"
            ref={sliderRef}
            onScroll={handleScroll}
            data-sr-stagger
          >
            {features.map((f, i) => (
              <Card key={i} icon={f.icon} title={f.title} tealTop data-sr>
                {f.desc}
              </Card>
            ))}
          </div>

          {/* Pagination dots - only visible on mobile */}
          <div className="slider-dots">
            {features.map((_, i) => (
              <button
                key={i}
                className={"slider-dot" + (activeIndex === i ? " active" : "")}
                onClick={() => goToSlide(i)}
              />
            ))}
          </div>
        </div>
      </div>

      <CtaBanner
        title={`Ready to Get Started with ${title.split(".")[0]}?`}
        btn1={ctaLabel}
        onBtn1={() => { openDemoForm(); }}
      />
    </div>
  );
}

function SuccessPage({ setPage }) {
  const go = (p) => { setPage(p); window.scrollTo({ top: 0, behavior: "smooth" }); };
  // Add to your component:
  const storiesSliderRef = useRef(null);
  const [storiesIndex, setStoriesIndex] = useState(0);

  const scrollToStory = (index) => {
    const slider = storiesSliderRef.current;
    if (!slider) return;
    slider.children[index].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    setStoriesIndex(index);
  };

  useEffect(() => {
    const slider = storiesSliderRef.current;
    if (!slider) return;
    const handleScroll = () => {
      setStoriesIndex(Math.round(slider.scrollLeft / slider.offsetWidth));
    };
    slider.addEventListener("scroll", handleScroll, { passive: true });
    return () => slider.removeEventListener("scroll", handleScroll);
  }, []);
  const stories = [
    { text: "Before SchoolMentor, we were juggling spreadsheets, manual registers, and separate systems for fees and exams. Now everything is centralized — attendance, payroll, results, reports. It has reduced our administrative workload significantly.", name: "Mrs. Saima Rahman", role: "Principal" },
    { text: "What I appreciate most is how much time it saves me. Attendance is marked in seconds, assignments are uploaded easily, and parents are automatically notified.", name: "Mr. Adeel Khan", role: "English Teacher" },
    { text: "Fee tracking and payroll used to be our biggest headache. With SchoolMentor, we can generate reports instantly and track pending payments without confusion.", name: "Ms. Hira Siddiqui", role: "Admin Manager" },
    { text: "As a parent, I no longer have to wait for PTMs to know how my child is doing. I get updates about attendance, homework, and announcements directly on my phone.", name: "Mr. Imran Shah", role: "Parent" },
    { text: "The training sessions were practical and relevant to our daily challenges. Our teachers feel more confident using technology now.", name: "Dr. Nadia Farooq", role: "Vice Principal, Horizon International School" },
  ];
  return (

    <>
      <style>
        {`
        /* ── Mobile slider (default) ── */
.stories-slider-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.stories-slider {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  gap: 16px;
  padding: 4px 2px 8px;
}
.stories-slider::-webkit-scrollbar { display: none; }

.stories-slide {
  flex: 0 0 85%;
  scroll-snap-align: center;
  max-width: 340px;
}

.stories-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
}
.stories-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #d1d5db;
  cursor: pointer;
  padding: 0;
  transition: background 0.2s, transform 0.2s;
}
.stories-dot.active {
  background: #4f46e5;
  transform: scale(1.3);
}

.stories-desktop-grid {
  display: none !important;
}

/* ── Desktop grid (≥ 768px) ── */
@media (min-width: 768px) {
  .stories-slider-wrapper {
    display: none;
  }
  .stories-desktop-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
}
        `}
      </style>
      <div className="page-enter">
        <div>
          <SuccessHeroi />
        </div>
        <div style={s.section(false)}>
          <div style={s.sectionInner}>

            {/* Mobile Slider */}
            <div className="stories-slider-wrapper">
              <div className="stories-slider" ref={storiesSliderRef}>
                {stories.map((story, i) => (
                  <div key={i} className="stories-slide">
                    <div className="sm-card" style={{ background: "var(--sm-surface)", border: `1px solid ${T.gray100}`, borderRadius: 12, padding: 24 }}>
                      <blockquote style={{ fontSize: 14, fontStyle: "italic", color: T.gray700, lineHeight: 1.7, marginBottom: 16, paddingLeft: 14, borderLeft: `3px solid ${T.teal}` }}>
                        {story.text}
                      </blockquote>
                      <div style={{ fontWeight: 600, fontSize: 14, color: T.navy }}>{story.name}</div>
                      <div style={{ fontSize: 13, color: T.gray500 }}>{story.role}</div>
                    </div>
                  </div>
                ))}
              </div>
              <div className="stories-dots">
                {stories.map((_, i) => (
                  <button
                    key={i}
                    className={`stories-dot${storiesIndex === i ? " active" : ""}`}
                    onClick={() => scrollToStory(i)}
                    aria-label={`Go to story ${i + 1}`}
                  />
                ))}
              </div>
            </div>

            {/* Desktop Grid */}
            <div className="stories-desktop-grid">
              {stories.map((story, i) => (
                <div key={i} className="sm-card" style={{ background: "var(--sm-surface)", border: `1px solid ${T.gray100}`, borderRadius: 12, padding: 24 }}>
                  <blockquote style={{ fontSize: 14, fontStyle: "italic", color: T.gray700, lineHeight: 1.7, marginBottom: 16, paddingLeft: 14, borderLeft: `3px solid ${T.teal}` }}>
                    {story.text}
                  </blockquote>
                  <div style={{ fontWeight: 600, fontSize: 14, color: T.navy }}>{story.name}</div>
                  <div style={{ fontSize: 13, color: T.gray500 }}>{story.role}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <CtaBanner title="Add Your School's Story" btn1="Share Your Story" btn2="Book a Free Demo" onBtn1={() => go("contact")} onBtn2={() => { openDemoForm(); }} />
      </div>
    </>
  );
}

