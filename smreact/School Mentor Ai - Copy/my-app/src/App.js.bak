        <PricingCards />
      </div>
      <div>
        <PricingCalculator />
      </div>


      {/* CTA */}
      <CtaBanner
        title="Get Your Personalised Quote"
        sub="Our team will prepare a custom proposal for your school within 24 hours."
        btn1="Get My Quote"
        btn2="Book a Free Demo"
        onBtn1={() =>
          window.open(
            "https://wa.me/923700036867?text=Hello%20I%20am%20interested%20in%20your%20services",
            "_blank"
