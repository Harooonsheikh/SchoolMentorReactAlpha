// ─── GLOBAL STYLES (injected once) ───────────────────────────────────────────
const GLOBAL_CSS = `
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap');
  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { font-family:'DM Sans',sans-serif; color:var(--sm-text); background:var(--sm-bg); font-size:16px; line-height:1.65; transition:background .3s ease, color .3s ease; }
  h1,h2,h3,h4 { font-family:'DM Sans',serif; line-height:1.2; }
  a { text-decoration:none; color:inherit; }
  button { font-family:'DM Sans',sans-serif; cursor:pointer; border:none; }
  input,select,textarea { font-family:'DM Sans',sans-serif; }
  ::-webkit-scrollbar { width:6px; }
  ::-webkit-scrollbar-track { background:var(--sm-surface-alt); }
  ::-webkit-scrollbar-thumb { background:var(--sm-gray300); border-radius:3px; }

  .page-enter { animation: fadeUp 0.35s ease both; }
  @keyframes fadeUp {
    from { opacity:0; transform:translateY(18px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* ── Premium animation library ─────────────────────────────────── */
  @keyframes smFadeIn   { from { opacity:0; } to { opacity:1; } }
  @keyframes smFadeUp   { from { opacity:0; transform:translateY(26px); } to { opacity:1; transform:translateY(0); } }
  @keyframes smSlideL   { from { opacity:0; transform:translateX(-32px); } to { opacity:1; transform:translateX(0); } }
  @keyframes smSlideR   { from { opacity:0; transform:translateX(32px); }  to { opacity:1; transform:translateX(0); } }
  @keyframes smScaleIn  { from { opacity:0; transform:scale(.94); } to { opacity:1; transform:scale(1); } }
  @keyframes smFloat    { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-10px); } }
  @keyframes smGlow     { 0%,100% { opacity:.45; } 50% { opacity:.9; } }
  @keyframes smSheen    { 0% { transform:translateX(-130%); } 100% { transform:translateX(130%); } }

  /* ── Scroll-reveal system (JS-gated so content never hides without JS) ── */
  html.sr-on [data-sr] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity .7s cubic-bezier(.22,.61,.36,1), transform .7s cubic-bezier(.22,.61,.36,1);
    transition-delay: var(--sr-delay, 0ms);
    will-change: opacity, transform;
  }
  html.sr-on [data-sr="fade"]  { transform: none; }
  html.sr-on [data-sr="left"]  { transform: translateX(-32px); }
  html.sr-on [data-sr="right"] { transform: translateX(32px); }
  html.sr-on [data-sr="scale"] { transform: scale(.94); }
  html.sr-on [data-sr].sr-in   { opacity: 1; transform: none; }

  /* ── Standard premium card hover (opt-in via .sm-card) ─────────── */
  .sm-card {
    transition: transform .28s cubic-bezier(.22,.61,.36,1), box-shadow .28s cubic-bezier(.22,.61,.36,1), border-color .28s ease;
    will-change: transform;
  }
  .sm-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px -12px var(--sm-shadow);
    border-color: var(--sm-teal);
  }

  /* ── Button micro-interactions + a11y focus ────────────────────── */
  button { transition: transform .12s ease, box-shadow .2s ease, background .2s ease, color .2s ease; }
  button:active { transform: translateY(1px) scale(.985); }
  a:focus-visible, button:focus-visible, [role="button"]:focus-visible,
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--sm-teal);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* Respect reduced-motion: disable all reveal + decorative motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
    html.sr-on [data-sr] { opacity: 1 !important; transform: none !important; }
  }

  .cta-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(0,0,0,.18); }
  .cta-btn-ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; }

  .dropdown-menu { display: block; }
  .dropdown:hover .dropdown-menu { display:block; }

  @media(max-width:900px){
    .hide-mobile { display:none !important; }
    .hero-grid { grid-template-columns:1fr !important; }
    .hero-dashboard { display:none !important; }
    .footer-grid { grid-template-columns:1fr 1fr !important; }
    .pricing-grid { grid-template-columns:1fr !important; }
    .cards-grid-4 { grid-template-columns:1fr 1fr !important; }
  }
    
  @media(max-width:600px){
    .footer-grid { grid-template-columns:1fr !important; }
    .form-grid-2 { grid-template-columns:1fr !important; }
    .cards-grid-4 { grid-template-columns:1fr !important; }
    .cards-grid-3 { grid-template-columns:1fr !important; }
    .stats-grid { grid-template-columns:1fr 1fr !important; }
  }
`;

// ─── RESPONSIVE HOOK ─────────────────────────────────────────────────────────
// Reading window.innerWidth straight into a local during render captures the
// width once and never updates: rotating a phone, or the browser UI collapsing
// on scroll, left these pages rendering the desktop branch at phone width until
// something unrelated forced a re-render. Subscribing to resize + the
// orientation media query keeps the layout honest.
function useIsMobile(breakpoint = 768) {
  const [isMobile, setIsMobile] = useState(
    () => (typeof window !== "undefined" ? window.innerWidth <= breakpoint : false)
  );
  useEffect(() => {
    const mq = window.matchMedia(`(max-width: ${breakpoint}px)`);
    const update = () => setIsMobile(mq.matches);
    update();
    mq.addEventListener("change", update);
    window.addEventListener("resize", update);
    window.addEventListener("orientationchange", update);
    return () => {
      mq.removeEventListener("change", update);
      window.removeEventListener("resize", update);
      window.removeEventListener("orientationchange", update);
    };
  }, [breakpoint]);
  return isMobile;
}

// ─── SHARED PRIMITIVES ───────────────────────────────────────────────────────
// Responsive content width: floored at 1200px so it is identical to the old fixed
// cap on every viewport ≤ ~1290px (no change to mobile/tablet/standard desktop),
// then grows up to 1850px on large / extra-large screens.
const CONTAINER = "clamp(1200px, 93vw, 1850px)";
const s = {
  // Button
  btn: (variant = "teal", size = "md") => ({
    display: "inline-flex", alignItems: "center", gap: 6,
    padding: size === "lg" ? "14px 28px" : size === "sm" ? "8px 16px" : "10px 20px",
    borderRadius: 8,
    fontSize: size === "lg" ? 16 : size === "sm" ? 5 : 14,
    fontWeight: 500, cursor: "pointer", transition: "all 0.15s",
    border: variant === "outlineTeal" ? `1.5px solid ${T.teal}`
      : variant === "outlineWhite" ? "1.5px solid rgba(255,255,255,0.5)"
        : variant === "outlineNavy" ? `1.5px solid ${T.navy}`
          : "none",
    background: variant === "teal" ? T.teal
      : variant === "wa" ? "#25D366"
        : "transparent",
    color: variant === "teal" ? "#fff"
      : variant === "wa" ? "#fff"
        : variant === "outlineTeal" ? T.teal
          : variant === "outlineWhite" ? "#fff"
            : T.navy,
  }),
  // Card
  card: (highlight = false) => ({
    // background: "var(--sm-surface)",
    border: highlight ? `2px solid ${T.teal}` : `1px solid ${T.gray100}`,
    borderRadius: 12,
    padding: "24px",
    transition: "box-shadow 0.2s, transform 0.2s",
  }),
  section: (alt = false) => ({
    padding: "clamp(16px, 2vw, 24px)",
    background: alt ? T.gray50 : "",
  }),
  sectionInner: { maxWidth: CONTAINER, margin: "0 auto" },
  sectionLabel: { fontSize: 13, fontWeight: 700, letterSpacing: "0.1em", textTransform: "uppercase", color: T.teal, marginBottom: 8 },
  sectionTitle: (light = false) => ({ fontFamily: "'DM Sans', serif", fontSize: "clamp(1.5rem,3vw,2.6rem)", color: light ? "#fff" : T.navy, marginBottom: 12 }),
  sectionSub: (light = false) => ({ fontSize: "clamp(16px, 1vw, 18px)", color: light ? "rgba(255,255,255,0.78)" : T.gray500, maxWidth: 560, marginBottom: 40 }),
};

// ─── BUTTON COMPONENT ────────────────────────────────────────────────────────
function Btn({ variant = "teal", size = "md", onClick, children, style = {} }) {
  const [hover, setHover] = useState(false);
  const base = s.btn(variant, size);
  const hoverStyle = hover ? {
    background: variant === "teal" ? T.tealDark
      : variant === "wa" ? "#1da851"
        : variant === "outlineTeal" ? T.teal
          : variant === "outlineWhite" ? "rgba(255,255,255,0.1)"
            : T.navy,
    color: (variant === "outlineTeal" || variant === "outlineNavy") && hover ? "#fff" : base.color,
  } : {};
  return (
    <button
      style={{ ...base, ...hoverStyle, ...style }}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      onClick={onClick}
    >{children}</button>
  );
}

// ─── NAVBAR ──────────────────────────────────────────────────────────────────
function Navbar({ page, setPage }) {
  const [mobileOpen, setMobileOpen] = useState(false);
  const [loginOpen, setLoginOpen] = useState(false);
  const [servicesOpen, setServicesOpen] = useState(false);
  const isMobile = useIsMobile();

  const services = [
    { label: "School Mentor ERP", page: "web" },
    { label: "School Mentor Mobile App", page: "mobile" },
    { label: "School Operational Manuals", page: "manuals" },
    { label: "Teachers Trainings", page: "trainings" },
    { label: "School Mentor AI", page: "ai" },
  ];

  const nav = [
    { label: "Home", page: "home" },
    { label: "Services", dropdown: services },
    { label: "About Us", page: "about" },
    { label: "Pricing", page: "pricing" },
    { label: "Success Stories", page: "success" },
    { label: "FAQ's", page: "faq" },
    { label: "Contact", page: "contact" },
  ];

  const go = (p) => {
    setPage(p);
    setMobileOpen(false);
    setLoginOpen(false);
    setServicesOpen(false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  // Close dropdowns when clicking outside
  useEffect(() => {
    const handleClick = (e) => {
      if (!e.target.closest(".login-wrapper")) setLoginOpen(false);
    };
    document.addEventListener("mousedown", handleClick);
    return () => document.removeEventListener("mousedown", handleClick);
  }, []);

  return (
    <>
      <style>{`
        /* ── Reset & Base ───────────────────── */
        * { box-sizing: border-box; }

        .nav-link-item {
          padding: 6px 12px;
          font-size: 14px;
          font-weight: 500;
          color: ${T.gray700};
          border-radius: 6px;
          cursor: pointer;
          white-space: nowrap;
          transition: background 0.15s, color 0.15s;
          user-select: none;
        }
        .nav-link-item:hover { background: ${T.gray50}; color: ${T.navy}; }
        .nav-link-item.active { color: ${T.teal}; }

        /* ── Desktop Dropdown ───────────────── */
        .dropdown { position: relative; }
        .dropdown-menu {
          display: none;
          position: absolute;
          top: calc(100% + 4px);
          left: 0;
          background: var(--sm-surface);
          border: 1px solid ${T.gray100};
          border-radius: 10px;
          padding: 6px;
          min-width: 220px;
          box-shadow: 0 8px 40px rgba(30,58,95,0.13);
          z-index: 200;
        }
        .dropdown:hover .dropdown-menu { display: block; }
        .dd-item {
          display: block;
          padding: 8px 12px;
          font-size: 13px;
          color: ${T.gray700};
          border-radius: 6px;
          cursor: pointer;
          transition: background 0.15s;
        }
        .dd-item:hover { background: ${T.gray50}; color: ${T.navy}; }

        /* ── Login Dropdown ─────────────────── */
        .login-dd-item {
          padding: 10px;
          cursor: pointer;
          font-size: 14px;
          color: #334155;
          border-radius: 6px;
          transition: background 0.15s, color 0.15s;
        }
        .login-dd-item:hover { background: #f1f5f9; color: #2563EB; }

        /* ── Mobile Menu ────────────────────── */
        .mob-link {
          padding: 12px 16px;
          border-radius: 8px;
          font-size: 15px;
          cursor: pointer;
          color: ${T.gray700};
          font-weight: 500;
          transition: background 0.15s;
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
        .mob-link:hover { background: ${T.gray50}; color: ${T.navy}; }
        .mob-link.active { color: ${T.teal}; }

        .mob-sub-link {
          padding: 10px 16px 10px 32px;
          border-radius: 8px;
          font-size: 14px;
          cursor: pointer;
          color: ${T.gray600};
          transition: background 0.15s;
        }
        .mob-sub-link:hover { background: ${T.gray50}; color: ${T.navy}; }

        /* ── Responsive Visibility ──────────── */
        @media (min-width: 768px) {
          .desktop-nav { display: flex !important; }
          .desktop-cta { display: flex !important; }
          .mobile-cta { display: none !important; }
          .hamburger { display: none !important; }
          .mobile-drawer { display: none !important; }
        }
        @media (max-width: 767px) {
          .desktop-nav { display: none !important; }
          .desktop-wa { display: none !important; }
          .hamburger { display: flex !important; }
        }
      `}</style>
      <div>
        <Navbari />
      </div>

    </>
  );
}
