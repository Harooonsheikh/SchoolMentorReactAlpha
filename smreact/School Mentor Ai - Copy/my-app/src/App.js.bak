function FaqPage({ setPage }) {
  const go = (p) => { setPage(p); window.scrollTo({ top: 0, behavior: "smooth" }); };
  const sections = [
    {
      title: "General Questions", items: [
        { q: "What is SchoolMentor®?", a: "SchoolMentor® is Pakistan's all-in-one school management platform. It digitizes and automates school operations including attendance, fee management, HR & payroll, exams, academics, and parent-teacher communication." },
        { q: "Who is it designed for?", a: "It is built for private and semi-government schools across Pakistan and serves all four stakeholders: administrators, principals, teachers, students, and parents — each with a customized interface." },
        { q: "Is SchoolMentor® a Pakistani product?", a: "Yes. Proudly developed in Pakistan, headquartered in Islamabad (Bahria Phase-IV), and specifically designed for Pakistani schools and curricula." },
        { q: "Has SchoolMentor® been featured anywhere?", a: "Yes. SchoolMentor® was featured on Shark Tank Pakistan, demonstrating its credibility as a recognized EdTech innovator." },
      ]
    },
    {
      title: "Features & Products", items: [
        { q: "What does the web platform include?", a: "Attendance, fee management, HR & payroll, exams, academic scheduling, results, report cards, role-based permissions, and analytics dashboards." },
        { q: "What does the mobile app do?", a: "Real-time attendance alerts to parents, homework uploads by teachers, fee payment status, school announcements, and academic progress tracking from any smartphone." },
        { q: "What is the AI Lesson Plans feature?", a: "Currently in development. This upcoming feature will allow teachers to generate lesson plans, classwork, and assignments using AI in minutes. Expected launch Q3 2026." },
      ]
    },
    {
      title: "Implementation & Pricing", items: [
        { q: "How long does setup take?", a: "Most schools are fully onboarded within 1–2 weeks. Basic setup begins within 24–48 hours of sign-up." },
        { q: "Do we need an IT team?", a: "No. SchoolMentor® is designed to be managed by school administrators without technical knowledge. Full onboarding support is included." },
        { q: "How much does it cost?", a: "Pricing is customized based on school size and modules required. Contact us for a personalized quote." },
        { q: "Is our school data secure?", a: "Yes. Industry-standard encryption, secure cloud infrastructure, and role-based access control protect all data." },
        { q: "What happens to our data if we leave?", a: "Your data belongs to you. We provide a full export in standard formats upon request." },
      ]
    },
  ];
  return (
    <div className="page-enter">
      <div>
        <FaqHero />
      </div>
      <div style={s.section(false)}>
