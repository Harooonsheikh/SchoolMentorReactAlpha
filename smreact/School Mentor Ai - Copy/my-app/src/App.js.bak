function OurSolutions() {
  return (
    <div style={{ background: "var(--sm-os-band)", padding: "clamp(16px, 2vw, 24px)" }}>
      <div style={{ maxWidth: CONTAINER, margin: "0 auto" }}>
        <SchoolOS />
      </div>
