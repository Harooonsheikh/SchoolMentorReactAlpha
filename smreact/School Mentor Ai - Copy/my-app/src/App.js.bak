function PricingPage({ setPage }) {
  const go = (p) => {
    setPage(p);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  const sliderRef = useRef(null);
  const [activeIndex, setActiveIndex] = useState(0);

  const handleScroll = () => {
    const slider = sliderRef.current;
    if (!slider || !slider.children.length) return;
    const cardWidth = slider.children[0].offsetWidth + 16;
    const index = Math.round(slider.scrollLeft / cardWidth);
    setActiveIndex(Math.min(index, plans.length - 1));
  };

  const goToSlide = (i) => {
    const slider = sliderRef.current;
    if (!slider || !slider.children.length) return;
    const cardWidth = slider.children[0].offsetWidth + 16;
    slider.scrollTo({ left: cardWidth * i, behavior: "smooth" });
    setActiveIndex(i);
  };

  const faqs = [
    { q: "Are there any hidden fees?", a: "No. All costs are communicated upfront during your consultation. Setup, data migration, and initial training are included." },
    { q: "Is there a free trial?", a: "Yes — we offer a free demo for all interested schools. Book via the button below." },
    { q: "Do you offer discounts for school chains?", a: "Yes. Special pricing is available for school networks and multi-branch institutions." },
    { q: "What payment methods do you accept?", a: "Bank transfer, JazzCash, EasyPaisa, and cheque. We issue formal invoices for all payments." },
  ];

  const plans = [
    {
      name: "School Mentor",
      for: "Complete School Operating System",
      features: [
        "Full access to ERP (Academics, Exams, HR, Accounts, Fees)",
        "3 Mobile Applications (Principal, Teachers & Parents)",
        "School Operational Manuals",
        "Monthly Teachers Training Workshops",
        "Dedicated Head Office Support"
      ],
      featured: false,
      showButton: false
    },
    {
      name: "School Mentor with Mentor AI",
      for: "AI-Powered Teaching & Academic Automation",
      features: [
        "Everything in School Mentor, plus",
        "AI Teaching Assistant for every teacher (full month support with chat)",
        "Generate lesson plans (Cambridge International + Bloom's Taxonomy based format)",
        "Save lesson plans directly in School Mentor ERP / Portal",
        "Create Question Banks with Answers from any publisher books (via image scanning)",
        "Generate AI-based Worksheets (Download instantly or save in portal)"
      ],
      featured: true,
      showButton: false
    },
    {
      name: "Enterprise (Custom Solution)",
      for: "For large schools, networks & chains",
      features: [
        "Everything in School Mentor + Mentor AI",
        "Custom workflows & integrations",
        "Multi-campus management",
        "Dedicated account manager",
        "On-site implementation & training",
        "Unlimited admin users"
      ],
      featured: false,
      soon: true,
      showButton: true
    },
  ];

  return (
    <div className="page-enter">

      <style>{`
        .pricing-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 24px;
          margin-bottom: 40px;
        }

        @media (max-width: 900px) {
          .pricing-grid {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            gap: 16px;
            padding-bottom: 12px;
            scrollbar-width: none;
            margin-bottom: 16px;
          }

          .pricing-grid::-webkit-scrollbar {
            display: none;
          }

          .pricing-grid > * {
            flex: 0 0 85%;
            scroll-snap-align: start;
          }

          .pricing-dots {
            display: flex !important;
          }

          .pricing-card {
            padding: 24px 18px !important;
          }

          .pricing-info-box {
            padding: 18px !important;
          }
        }

        .pricing-dots {
          display: none;
          justify-content: center;
          align-items: center;
          gap: 8px;
          margin-bottom: 28px;
        }

        .pricing-dot {
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: #cbd5e1;
          border: none;
          padding: 0;
          cursor: pointer;
          transition: background 0.3s, transform 0.3s;
        }

        .pricing-dot.active {
          background: #2563EB;
          transform: scale(1.3);
        }
      `}</style>

      {/* Header */}
      {/* Pricing Section */}
