// ─── ROOT APP ─────────────────────────────────────────────────────────────────
export default function App() {
  const [page, setPage] = useState("home");

  // Browser back/forward support
  const goTo = (newPage) => {
    window.history.pushState({ page: newPage }, '', `#${newPage}`);
    setPage(newPage);
  };

  useEffect(() => {
    window.history.replaceState({ page: 'home' }, '', '#home');

    const handlePop = (e) => {
      const p = e.state?.page || 'home';
      setPage(p);
    };
    window.addEventListener('popstate', handlePop);
    return () => window.removeEventListener('popstate', handlePop);
  }, []);

  // Inject global CSS once
  useEffect(() => {
    const style = document.createElement("style");
    style.textContent = GLOBAL_CSS;
    document.head.appendChild(style);
    return () => document.head.removeChild(style);
  }, []);

  // Global scroll-reveal — JS-gated so content is always visible without JS.
  // Any element with a data-sr attribute fades/slides in once on first view.
  // Containers marked data-sr-stagger cascade their data-sr children.
  useEffect(() => {
    const root = document.documentElement;
    root.classList.add("sr-on");

    const reduce = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return () => root.classList.remove("sr-on");

    // Reveal an element, then once its transition ends drop the data-sr
    // attribute so the persistent hidden-state rule stops governing it
    // (otherwise it would out-specify :hover transforms on cards).
    const settle = (el) => {
      const done = () => {
        el.removeAttribute("data-sr");
        el.style.removeProperty("will-change");
        el.style.removeProperty("--sr-delay");
        el.removeEventListener("transitionend", done);
      };
      el.addEventListener("transitionend", done);
      setTimeout(done, 1400); // fallback if no transition fires
    };
    const revealOne = (el, delay = 0) => {
      if (delay) el.style.setProperty("--sr-delay", `${delay}ms`);
      el.classList.add("sr-in");
      settle(el);
    };
    const reveal = (el) => {
      if (el.hasAttribute("data-sr-stagger")) {
        const kids = el.querySelectorAll(":scope [data-sr]");
        kids.forEach((k, i) => revealOne(k, Math.min(i, 8) * 80));
      }
      if (el.hasAttribute("data-sr")) revealOne(el);
    };

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { reveal(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });

    let raf = requestAnimationFrame(() => {
      // Stagger containers reveal their own children — observe the container.
      document.querySelectorAll("[data-sr-stagger]").forEach((el) => io.observe(el));
      // Standalone reveal elements not governed by a stagger container.
      document.querySelectorAll("[data-sr]").forEach((el) => {
        if (el.closest("[data-sr-stagger]")) return;
        io.observe(el);
      });
    });

    return () => { cancelAnimationFrame(raf); io.disconnect(); root.classList.remove("sr-on"); };
  }, [page]);
  const renderPage = () => {
    if (serviceData[page]) {
      const d = serviceData[page];
      return <ServicePage key={page} {...d} setPage={goTo} />;
    }
    if (audienceData[page]) {
      const d = audienceData[page];
      return <ServicePage key={page} {...d} setPage={goTo} />;
    }
    switch (page) {
      case "home": return <HomePage key="home" setPage={goTo} />;
      case "about": return <AboutPage key="about" setPage={goTo} />;
      case "pricing": return <PricingPage key="pricing" setPage={goTo} />;
      case "faq": return <FaqPage key="faq" setPage={goTo} />;
      case "contact": return <ContactPage key="contact" setPage={goTo} />;
      case "demo": return <DemoPage key="demo" setPage={goTo} />;
      case "success": return <SuccessPage key="success" setPage={goTo} />;
      case "blog": return <BlogPage key="blog" setPage={goTo} />;
      case "privacy": return <div><LegalPagei /></div>;
      case "terms": return <div><TermsAndConditionsi /></div>;
      default: return <Page404 key="404" setPage={goTo} />;
    }
  };
  return (
    <div style={{ minHeight: "100vh" }}>
      <Navbari page={page} setPage={goTo} />
      <main style={{ paddingTop: 0 }}>
        {renderPage()}
      </main>
      <Footeri setPage={goTo} />
      <WhatsAppButton />
      <DemoRequestModal />
    </div>
  );
}
