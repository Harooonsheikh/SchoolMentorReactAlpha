}

function HomePage({ setPage }) {
  const go = (p) => { setPage(p); window.scrollTo({ top: 0, behavior: "smooth" }); };
  const sliderRef = useRef(null);
  const [sliderIndex, setSliderIndex] = useState(0);
  const isMobile = useIsMobile();

  // Why Choose Us slider
  const whySliderRef = useRef(null);
  const [whyActiveSlide, setWhyActiveSlide] = useState(0);

  const scrollWhyToSlide = (index) => {
    const el = whySliderRef.current;
    if (!el) return;
    const cards = Array.from(el.children);
    const card = cards[index];
    if (!card) return;
    el.scrollTo({ left: card.offsetLeft, behavior: "smooth" });
    setWhyActiveSlide(index);
  };

  useEffect(() => {
    const el = whySliderRef.current;
    if (!el) return;
    const onScroll = () => {
      const cards = Array.from(el.children);
      let closest = 0;
      let minDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft - el.scrollLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      setWhyActiveSlide(closest);
    };
    el.addEventListener("scroll", onScroll, { passive: true });
    return () => el.removeEventListener("scroll", onScroll);
  }, []);

  const scrollToSlide = (index) => {
    const slider = sliderRef.current;
    if (!slider) return;
    const slide = slider.children[index];
    slide.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    setSliderIndex(index);
  };

  useEffect(() => {
    const slider = sliderRef.current;
    if (!slider) return;
    const handleScroll = () => {
      const slideWidth = slider.offsetWidth;
      const index = Math.round(slider.scrollLeft / slideWidth);
      setSliderIndex(index);
    };
    slider.addEventListener("scroll", handleScroll, { passive: true });
    return () => slider.removeEventListener("scroll", handleScroll);
  }, []);

  const testimonials = [
    { text: "Before SchoolMentor, we were juggling spreadsheets, manual registers, and separate systems for fees and exams. It was chaotic. Now everything is centralized — attendance, payroll, results, reports — all in one dashboard.", name: "Mrs. Saima Rahman", role: "Principal" },
    { text: "What I appreciate most is how much time it saves me. Attendance is marked in seconds, assignments are uploaded easily, and parents are automatically notified.", name: "Mr. Adeel Khan", role: "English Teacher" },
    { text: "Fee tracking and payroll used to be our biggest headache. With SchoolMentor, we can generate reports instantly and track pending payments without confusion.", name: "Ms. Hira Siddiqui", role: "Admin Manager" },
    { text: "As a parent, I no longer have to wait for PTMs to know how my child is doing. I get updates about attendance, homework, and announcements directly on my phone.", name: "Mr. Imran Shah", role: "Parent" },
    { text: "The training sessions were practical and relevant to our daily challenges. Our teachers feel more confident using technology now.", name: "Dr. Nadia Farooq", role: "Vice Principal, Horizon International School" },
  ];

  const whyItems = [
    { bold: "Save operational costs", rest: " by reducing manual work and inefficiencies." },
    { bold: "Increase student retention", rest: " with better communication and academic performance." },
    { bold: "Make faster decisions", rest: " with real-time data and reports." },
    { bold: "Scale your school", rest: " like a systemized organization, not a traditional setup." },
    { bold: "Compete with top schools", rest: " — without becoming a franchise." },
    { bold: "Invest once.", rest: " Improve every department." },
  ];

  return (
    <>
      <style>{`
        /* ════════════════════════════════════════════════════════════════
           HOME — refined color system (scoped to .home-modern only, so the
           rest of the site keeps its existing palette).
           3 colors: softer royal-blue primary · premium slate neutrals ·
           one indigo accent. Blue-tinted neutrals/shadows are neutralized
           to slate; the heavy navy is lightened to #3B82F6.
           ════════════════════════════════════════════════════════════════ */
        /* ════════════════════════════════════════════════════════════════
           HOME 2.0 — "Less is more" enterprise system. Exact 3-color spec:
           Primary Blue #2563EB · Dark Text #111827 · Light BG #F8FAFC.
           Neutrals: white + light gray (#E5E7EB). One accent = the same blue.
           ════════════════════════════════════════════════════════════════ */
        .home-modern {
          --sm-navy: #2563EB;            /* primary brand blue (exact spec)       */
          --sm-navy-dark: #1D4ED8;       /* pressed / hover blue                  */
          --sm-teal: #2563EB;            /* interactive == primary (single blue)  */
          --sm-teal-dark: #1D4ED8;
          --sm-teal-light: #EFF4FF;      /* light blue tint for icon chips        */
          --sm-accent: #2563EB;          /* collapse extra accents to one blue    */
          --sm-accent-soft: #EFF4FF;

          --sm-bg: #F8FAFC;              /* light section background               */
          --sm-surface: #FFFFFF;         /* white cards / white sections          */
          --sm-surface-alt: #F8FAFC;     /* light gray section                     */
          --sm-border: #E5E7EB;          /* single hairline border (exact spec)   */
          --sm-gray300: #D1D5DB;
          --sm-text: #111827;            /* dark text (exact spec)                */
          --sm-text-soft: #374151;
          --sm-text-muted: #6B7280;
          --sm-hover: #F3F4F6;
          --sm-navy-tint: #EFF4FF;
          --sm-shadow: rgba(17,24,39,0.06);  /* very soft neutral shadow          */
          --sm-os-band: #FFFFFF;

          /* Stats-strip tokens — shared StatsStrip flips to LIGHT only on Home.
             (Other pages keep the blue fallbacks baked into the component.)    */
          --sm-stats-bg: #F8FAFC;
          --sm-stats-fg: #111827;
          --sm-stats-fg-soft: #4B5563;
          --sm-stats-fg-mute: #9CA3AF;
          --sm-stats-chip: #EFF4FF;
          --sm-stats-accent: #2563EB;
          --sm-stats-line: #E5E7EB;

          /* The one retained blue band (final CTA) — clean, flat, no gradient */
          --sm-cta-grad: #2563EB;
        }
        /* Dark mode — premium slate (never heavy navy / pure black) */
        html[data-theme="dark"] .home-modern {
          --sm-navy: #60A5FA;
          --sm-navy-dark: #3B82F6;
          --sm-teal: #60A5FA;
          --sm-teal-dark: #3B82F6;
          --sm-teal-light: rgba(37,99,235,0.18);
          --sm-accent: #60A5FA;
          --sm-accent-soft: rgba(37,99,235,0.18);

          --sm-bg: #0B1120;
          --sm-surface: #0F172A;
          --sm-surface-alt: #111A2E;
          --sm-border: #1E293B;
          --sm-gray300: #334155;
          --sm-text: #F1F5F9;
          --sm-text-soft: #CBD5E1;
          --sm-text-muted: #94A3B8;
          --sm-hover: #16213A;
          --sm-navy-tint: rgba(37,99,235,0.18);
          --sm-shadow: rgba(0,0,0,0.5);
          --sm-os-band: #0B1120;

          --sm-stats-bg: #0F172A;
          --sm-stats-fg: #F1F5F9;
          --sm-stats-fg-soft: #CBD5E1;
          --sm-stats-fg-mute: #64748B;
          --sm-stats-chip: rgba(37,99,235,0.18);
          --sm-stats-accent: #60A5FA;
          --sm-stats-line: #1E293B;

          --sm-cta-grad: #1D4ED8;
        }

        /* ── Audience cards ── */
        .cards-grid-4 {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 20px;
          margin-top: 0;
        }
        .audience-card {
          background: var(--sm-surface);
          border: 1px solid ${T.gray100};
          border-radius: 12px;
          padding: clamp(16px, 3vw, 32px);
          cursor: pointer;
          transition: border-color 0.2s, box-shadow 0.2s;
        }
        .audience-card:hover {
          border-color: ${T.teal};
          box-shadow: 0 4px 20px rgba(30,58,138,0.12);
        }

        /* ── Testimonials grid ── */
        .cards-grid-3 {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
          margin-top: 24px;
        }

        /* ── Why Choose layout ── */
        .why-choose-grid {
          display: flex;
          flex-direction: row;
          width: 100%;
          gap: 32px;
          margin-top: 16px;
          align-items: center;
        }
        .why-choose-left {
          flex: 1;
          min-width: 0;
          display: flex;
          flex-direction: column;
        }
        .why-choose-list {
          display: flex;
          flex-direction: column;
          gap: 10px;
        }
        .why-choose-image-wrap {
          width: 50%;
          flex-shrink: 0;
        }
        .why-choose-image-wrap img {
          border-radius: 10px;
          width: 100%;
          box-shadow: 10px 10px 10px rgba(0,0,0,0.3);
          padding: 30px 0;
        }

        /* Dots hidden by default (desktop) */
        .why-choose-dots {
          display: none;
        }

        /* ── Tablet (768–1023px) ── */
        @media (min-width: 768px) and (max-width: 1023px) {
          .cards-grid-4 { grid-template-columns: repeat(2, 1fr); }
          .cards-grid-3 { grid-template-columns: repeat(2, 1fr); }
          .cards-grid-3 > *:last-child:nth-child(odd) {
            grid-column: 1 / -1;
            max-width: 480px;
            margin: 0 auto;
          }
          .why-choose-image-wrap { width: 42%; }
        }

        /* ── Mobile (≤767px) ── */
        @media (max-width: 767px) {
          .cards-grid-4 {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
          }
          .cards-grid-3 {
            grid-template-columns: 1fr;
            gap: 14px;
          }

          /* Why choose: stack vertically, image on top */
          .why-choose-grid {
            flex-direction: column;
            gap: 20px;
          }
          .why-choose-left {
            width: 100%;
          }
          .why-choose-image-wrap {
            width: 100%;
            order: -1;
          }
          .why-choose-image-wrap img {
            padding: 16px 0;
            box-shadow: 4px 4px 16px rgba(0,0,0,0.18);
          }

          /* List becomes horizontal scroll slider */
          .why-choose-list {
            flex-direction: row;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            gap: 12px;
            padding-bottom: 4px;
          }
          .why-choose-list::-webkit-scrollbar {
            display: none;
          }
          .why-choose-card {
            flex: 0 0 78vw;
            max-width: 290px;
            scroll-snap-align: start;
            box-sizing: border-box;
          }

          /* Show dots on mobile */
          .why-choose-dots {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-top: 14px;
          }
          .why-dot {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: rgba(255,255,255,0.3);
            cursor: pointer;
            transition: background 0.2s, width 0.2s;
            border: none;
            padding: 0;
          }
          .why-dot.active {
            width: 20px;
            background: #fff;
          }
        }

        /* ── Small phones (≤400px) ── */
        @media (max-width: 400px) {
          .cards-grid-4 { grid-template-columns: 1fr; }
          .why-choose-card { flex: 0 0 88vw; }
        }

        /* ── Testimonials slider (mobile) ── */
        .testimonials-slider-wrapper {
          display: flex;
          flex-direction: column;
          gap: 16px;
        }
        .testimonials-slider {
          display: flex;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          gap: 16px;
          padding: 4px 2px 8px;
        }
        .testimonials-slider::-webkit-scrollbar { display: none; }
        .testimonials-slide {
          flex: 0 0 85%;
          scroll-snap-align: center;
          max-width: 340px;
        }
        .testimonials-dots {
          display: flex;
          justify-content: center;
          gap: 8px;
        }
        .testimonials-dot {
          width: 8px;
          height: 8px;
          border-radius: 50%;
          border: none;
          background: #d1d5db;
          cursor: pointer;
          padding: 0;
          transition: background 0.2s, transform 0.2s;
        }
        .testimonials-dot.active {
          background: #4f46e5;
          transform: scale(1.3);
        }
        .testimonials-desktop-grid { display: none !important; }

        @media (min-width: 768px) {
          .testimonials-slider-wrapper { display: none; }
          .testimonials-desktop-grid { display: grid !important; }
        }
      `}</style>

      <div className="page-enter home-modern">
        <HeroSection setPage={setPage} />
        <div>
          <StatsStrip />
        </div>
        <div>
          {/* <div style={{
          ...s.section(true),
          paddingTop: 40,
          paddingBottom: 40,
          display: isMobile ? "none" : "block",
         }}>
          {/* <div style={{
            maxWidth: 1200, margin: "30 auto",
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
            gap: 24
          }}>
            {[["700+", "Schools Empowered"], ["7+", "Years Operating"], ["98%", "Client Satisfaction"], ["45+", "Cities Across Pakistan"]].map(([n, l]) => (
              <div key={l} style={{ textAlign: "center" }}>
                <div style={{
                  fontFamily: "'DM Sans',serif", fontSize: "clamp(28px, 5vw, 40px)",
                  color: T.navy, lineHeight: 1, fontWeight: "bold"
                }}>{n}</div>
                <div style={{ fontSize: 13, color: T.gray500, marginTop: 4 }}>{l}</div>
              </div>
            ))}
          </div> */}

        </div>

        {/* ── Audience Cards ── */}
        <AudienceCards2 s={s} T={T} />

        {/* ── Video Playlist ── */}
        {/* <VideoPlaylist /> */}

        {/* ── Our Solutions ── */}
        <OurSolutions setPage={setPage} />
        <div>
          < WhyChooseUs />
        </div>

        {/* ── Testimonials ── */}
        <Testimonialss />

        {/* ── CTA Banner ── */}
        <CtaBanner
          title="Reimagine Your School Experience Today"
          sub="Join 200+ schools across Pakistan who have transformed with SchoolMentor®"
          btn1=" Book a Free Demo"
          btn2=" WhatsApp: +923700036867"
          onBtn1={() => { openDemoForm(); }}
          onBtn2={() => go("contact")}
        />
      </div >
    </>
  );
}

