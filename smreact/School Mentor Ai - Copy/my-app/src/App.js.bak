            <Btn variant="teal" onClick={() => go("contact")}>Still Have Questions?</Btn>
            <Btn variant="outlineTeal" onClick={() => { openDemoForm(); }}>Book a Free Demo</Btn>
          </div>
        </div>
      </div>
    </div>
  );
}

