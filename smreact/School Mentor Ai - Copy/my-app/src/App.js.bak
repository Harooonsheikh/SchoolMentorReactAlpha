// ─── CTA BANNER ──────────────────────────────────────────────────────────────
function CtaBanner({ title, sub, btn1, btn2, onBtn1, onBtn2 }) {
  return (
    <div style={{ background: "var(--sm-cta-grad, linear-gradient(135deg, #2563EB, #3B82F6))", padding: "clamp(56px, 9vw, 96px) clamp(20px, 6vw, 24px)", textAlign: "center" }}>
      <h2 style={{ ...s.sectionTitle(true), fontSize: "clamp(1.6rem,3vw,2.4rem)", fontWeight: 800, letterSpacing: "-0.01em", marginBottom: 14, maxWidth: 760, marginLeft: "auto", marginRight: "auto" }}>{title}</h2>
      {sub && <p style={{ ...s.sectionSub(true), color: "rgba(255,255,255,0.88)", maxWidth: 560, margin: "0 auto 36px" }}>{sub}</p>}
      <div style={{ display: "flex", justifyContent: "center", flexWrap: "wrap", gap: 14 }}>
        <button className="cta-btn-primary" onClick={onBtn1}
          style={{ background: "#fff", color: "#2563EB", border: "1px solid #fff", padding: "14px 30px", borderRadius: 10, fontSize: 15, fontWeight: 700, cursor: "pointer", fontFamily: "'DM Sans',sans-serif", transition: "transform .18s ease, box-shadow .2s ease" }}>
          {btn1}
        </button>
        {btn2 && (
          <button className="cta-btn-ghost" onClick={onBtn2}
            style={{ background: "transparent", color: "#fff", border: "1px solid rgba(255,255,255,0.6)", padding: "14px 30px", borderRadius: 10, fontSize: 15, fontWeight: 600, cursor: "pointer", fontFamily: "'DM Sans',sans-serif", transition: "background .2s ease, border-color .2s ease" }}>
            {btn2}
          </button>
        )}
      </div>
    </div>
  );
}

// ─── FAQ ACCORDION ───────────────────────────────────────────────────────────
function FaqAccordion({ items }) {
  const [open, setOpen] = useState(null);
  const [hov, setHov] = useState(null);
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
      {items.map((item, i) => {
        const isOpen = open === i;
        const isHov = hov === i;
        return (
          <div
            key={i}
            onMouseEnter={() => setHov(i)}
            onMouseLeave={() => setHov(null)}
            style={{
              background: "var(--sm-surface)",
              border: `1px solid ${isOpen || isHov ? T.teal : T.gray100}`,
              borderRadius: 12,
              overflow: "hidden",
              boxShadow: isOpen ? "0 12px 32px -14px var(--sm-shadow)" : "none",
              transition: "border-color .25s ease, box-shadow .25s ease",
            }}
          >
            <div
              onClick={() => setOpen(isOpen ? null : i)}
              onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); setOpen(isOpen ? null : i); } }}
              role="button"
              tabIndex={0}
              aria-expanded={isOpen}
              style={{ padding: "16px 20px", fontWeight: 600, fontSize: 14, color: isOpen ? T.navy : T.text, cursor: "pointer", display: "flex", justifyContent: "space-between", alignItems: "center", gap: 16, transition: "color .2s ease" }}
            >
              {item.q}
              <span style={{
                flexShrink: 0, width: 26, height: 26, borderRadius: "50%",
                display: "inline-flex", alignItems: "center", justifyContent: "center",
                background: isOpen ? T.teal : T.gray50, color: isOpen ? "#fff" : T.teal,
                transition: "transform .28s cubic-bezier(.4,0,.2,1), background .25s ease, color .25s ease",
                transform: isOpen ? "rotate(180deg)" : "none", fontSize: 14,
              }}>▾</span>
            </div>
            {/* Smooth height animation via grid-template-rows (content always rendered) */}
            <div style={{ display: "grid", gridTemplateRows: isOpen ? "1fr" : "0fr", transition: "grid-template-rows .32s cubic-bezier(.4,0,.2,1)" }}>
              <div style={{ overflow: "hidden" }}>
                <div style={{ padding: "4px 20px 18px", fontSize: 14, color: T.gray500, lineHeight: 1.75, borderTop: `1px solid ${T.gray100}` }}>
                  {item.a}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}




// ─── CARD COMPONENT ──────────────────────────────────────────────────────────
function Card({ icon, title, children, tealTop = false, onClick, ...rest }) {
  const [hover, setHover] = useState(false);
  return (
    <div onClick={onClick} {...rest}
      onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}
      style={{ background: "var(--sm-surface)", border: `1px solid ${T.gray100}`, borderTop: tealTop ? `3px solid ${T.teal}` : `1px solid ${T.gray100}`, borderRadius: 12, padding: 24, cursor: onClick ? "pointer" : "default", transition: "box-shadow 0.28s cubic-bezier(.22,.61,.36,1), transform 0.28s cubic-bezier(.22,.61,.36,1), border-color 0.28s ease", boxShadow: hover ? "0 18px 44px -12px var(--sm-shadow)" : "0 1px 3px rgba(15,23,42,0.04)", transform: hover ? "translateY(-4px)" : "none", borderColor: hover ? T.teal : undefined }}>
      {icon && <div style={{ fontSize: 28, marginBottom: 12, color: T.teal, lineHeight: 1 }}>{icon}</div>}
      <h3 style={{ fontSize: 13, fontWeight: 600, fontFamily: "'DM Sans',sans-serif", color: T.navy, marginBottom: 8 }}>{title}</h3>
      <p style={{ fontSize: 13, color: T.gray500, lineHeight: 1.65 }}>{children}</p>
    </div>
  );
}

// ─── TESTIMONIAL CARD ────────────────────────────────────────────────────────
function Testimonial({ text, name, role }) {
  return (
    <div style={{ background: "var(--sm-surface)", border: `1px solid ${T.gray100}`, borderRadius: 12, padding: 24, position: "relative" }}>
      <div style={{ fontFamily: "'DM Sans',serif", fontSize: 56, color: T.teal, opacity: 0.25, position: "absolute", top: 8, left: 20, lineHeight: 1 }}>"</div>
      <p style={{ fontSize: 14, fontStyle: "italic", color: T.gray700, lineHeight: 1.7, paddingTop: 28, marginBottom: 16 }}>{text}</p>
      <div style={{ fontWeight: 600, fontSize: 14, color: T.navy }}>{name}</div>
      <div style={{ fontSize: 13, color: T.gray500 }}>{role}</div>
    </div>
  );
}

// ─── HERO + DASHBOARD ────────────────────────────────────────────────────────
function HeroSection({ setPage }) {
  const go = (p) => { setPage(p); window.scrollTo({ top: 0, behavior: "smooth" }); };
  const isMobile = useIsMobile();
  const screens = [
    { src: IMG_ACADEMICS, label: "Scheme of Studies", alt: "Academics module" },
    { src: IMG_DASHBOARD, label: "Admin Dashboard", alt: "Admin dashboard" },
    { src: IMG_LESSON, label: "Lesson Plans", alt: "Lesson plans" },
  ];

  return (
    <>
      <div>
        <SchoolMentorHero />   {/* ← add this */}
        {/* rest of your existing code */}
      </div>
    </>
  );
}
