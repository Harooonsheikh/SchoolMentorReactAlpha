              <h3 style={{ fontSize: 18, fontWeight: 600, fontFamily: "'DM Sans',sans-serif", color: T.navy, marginBottom: 16, paddingBottom: 12, borderBottom: `2px solid ${T.gray100}` }}>{sec.title}</h3>
