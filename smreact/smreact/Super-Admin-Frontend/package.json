{
  "name": "super-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "School Mentor — Super Admin frontend (React). Self-contained admin console with a mock data layer and a .NET API integration layer.",
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:dashboard": "react-scripts test --watchAll=false --testPathPattern src/superadmin/dashboard",
    "verify:dashboard": "node scripts/verify-dashboard.js",
    "lint:dashboard": "eslint --max-warnings=0 src/superadmin/Dashboard.jsx src/superadmin/OneLinkSection.jsx src/superadmin/dashboard src/superadmin/format.js src/superadmin/api/services/dashboard.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/superadmin/Dashboard.jsx",
          "src/superadmin/OneLinkSection.jsx"
        ],
        "rules": {
          "no-restricted-syntax": [
            "error",
            {
              "selector": "LogicalExpression[operator='||'][right.type='Literal'][right.value=0]",
              "message": "Dashboard data rule: do not default an API value to 0 — keep null and render '—' (DASHBOARD_DATA_STANDARD.md)."
            },
            {
              "selector": "CallExpression[callee.property.name='toLocaleString']",
              "message": "Dashboard data rule: format through src/superadmin/format.js."
            }
          ],
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                {
                  "name": "./dashboardData",
                  "message": "Removed — use ./format."
                },
                {
                  "name": "./api/services/payments",
                  "importNames": [
                    "loadFeeLedger",
                    "feeRowOf",
                    "remainingDuesOf"
                  ],
                  "message": "Dashboard must not recalculate fees — use admin_dashboard via the metric registry."
                }
              ],
              "patterns": []
            }
          ]
        }
      },
      {
        "files": [
          "src/superadmin/dashboard/**/*.test.js"
        ],
        "rules": {
          "testing-library/no-node-access": "off",
          "testing-library/no-wait-for-multiple-assertions": "off",
          "testing-library/no-unnecessary-act": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
