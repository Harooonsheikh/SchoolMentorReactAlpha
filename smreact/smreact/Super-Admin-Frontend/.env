# Port for the Super Admin dev server (main app stays on 3000)
PORT=3001

# Work around the CRA/Windows "Plugin react was conflicted between
# package.json and BaseConfig" error, which happens when the dev server is
# started from a path whose letter-case differs from the real folder name
# (Super-admin-frontend vs Super-Admin-Frontend). This skips the in-webpack
# ESLint plugin so the app compiles; run `npx eslint src` to lint manually.
DISABLE_ESLINT_PLUGIN=true

# ── API host (sandbox ACTIVE) ──
# setupProxy + erpPublicUrl + Support all follow this.
REACT_APP_SA_API_HOST=https://sandbox-alphaapi.schoolmentor.ai
# REACT_APP_SA_API_HOST=https://alphaapi.schoolmentor.ai

# ── Super Admin API ──
# Empty = MOCK MODE (bundled demo data, no backend needed)
REACT_APP_SA_API=
REACT_APP_SA_TOKEN=
REACT_APP_SA_USE_MOCK=
REACT_APP_SA_MOCK_LATENCY=180

# ── Customer Support API ──
# Empty → follows REACT_APP_SA_API_HOST on localhost; same-origin on deploy.
REACT_APP_SUPPORT_API=

# Hub abhi deploy nahi hua; 'true' us din karna jab /hubs/support live ho.
REACT_APP_SUPPORT_REALTIME=
