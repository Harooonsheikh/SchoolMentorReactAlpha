# Production-only settings (used by `npm run build`, NOT `npm start`).
# Base path for IIS deployment under /superadmin. This keeps the dev server
# at http://localhost:3001/ while the built assets resolve under /superadmin/.
PUBLIC_URL=/superadmin

# Point the Super Admin app at your live .NET backend for production builds.
# Leave empty to build in mock mode.
REACT_APP_SA_API=
