# Production-only settings (used by `npm run build`, NOT `npm start`).
# Relative base path: assets are referenced as ./static/... so the build works
# wherever it is served — at the site root (http://host:4105/) OR under a
# sub-path like /superadmin — with no server rewrite needed.
# (If you deploy STRICTLY under /superadmin and prefer absolute paths, set
#  PUBLIC_URL=/superadmin and serve the build folder at that exact path.)
PUBLIC_URL=.

# Point the Super Admin app at your live .NET backend for production builds.
# Leave empty to build in mock mode.
REACT_APP_SA_API=

# Full absolute URLs for the shared backend APIs. In production there is no
# dev proxy (src/setupProxy.js is dev-server-only), so the browser must call
# these hosts directly with their FULL path:
#   ERP branch directory   -> http://50.190.164.42:4100/api/Registration/get-all-branches
#   AI/wallet subscriptions -> http://50.190.164.42:8000/ai/api/wallet/admin/branches/subscriptions/
# These bases are prepended to the endpoint paths in src/superadmin/api/config.js.
REACT_APP_SA_ERP_BASE=http://50.190.164.42:4100
REACT_APP_SA_AI_BASE=http://50.190.164.42:8000
