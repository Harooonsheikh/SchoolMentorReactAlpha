# Production-only settings (used by `npm run build`, NOT `npm start`).
# Relative base path: assets are referenced as ./static/... so the build works
# wherever it is served — at the site root (http://host:4105/) OR under a
# sub-path like /superadmin — with no server rewrite needed.
# (If you deploy STRICTLY under /superadmin and prefer absolute paths, set
#  PUBLIC_URL=/superadmin and serve the build folder at that exact path.)
PUBLIC_URL=.

# Point the Super Admin app at your live .NET backend for production builds.
# Leave empty to build in mock mode.
REACT_APP_SA_API=

# SAME-ORIGIN in production. The site is served over HTTPS (e.g. https://IP:4105),
# and a browser blocks an https page from calling the API at http://IP:4100
# (mixed content). The backend also sends NO CORS header for this origin, so a
# cross-origin https://erp.schoolmentor.ai call is blocked too.
#
# So all three bases are LEFT EMPTY → the app calls its OWN origin with a
# relative path (/api/..., /SchoolMentorSuperAdminAPI/..., /ai/...), and IIS on
# the site reverse-proxies those to the backends server-to-server — see the
# rewrite rules in public/web.config. This mirrors how the ERP app works and
# needs no CORS. (Requires ARR "Enable proxy" + URL Rewrite on the IIS site.)
#   ERP branch directory    -> /api/Registration/...            -> localhost:4100
#   School Permissions       -> /SchoolMentorSuperAdminAPI/...   -> localhost:4100
#   AI/wallet subscriptions  -> /ai/api/wallet/...               -> localhost:8000
REACT_APP_SA_ERP_BASE=
REACT_APP_SA_AI_BASE=
REACT_APP_SA_ADMIN_BASE=
