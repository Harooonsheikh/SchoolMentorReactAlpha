# ════════════════════════════════════════════════════════════════════
# School Mentor — frontend environment (Create React App)
# Copy to `.env` (or `.env.local`) and fill in for your environment.
# Every var must be prefixed REACT_APP_ to reach the browser bundle.
# ════════════════════════════════════════════════════════════════════

# ── Super Admin API (the .NET backend for the #superadmin app) ──
# Leave REACT_APP_SA_API empty to run in MOCK MODE (bundled demo data, no
# backend needed). Set it to your .NET host to go live — the app then calls
# GET/POST/PUT/DELETE under <base>/api/superadmin/... with a Bearer JWT.
REACT_APP_SA_API=
# Optional bridge JWT for the standalone dev app (the embed host normally
# injects this at runtime via configureSuperAdmin({ token })).
REACT_APP_SA_TOKEN=
# Force a mode regardless of the base URL: true = always mock, false = always
# live. Leave unset to auto-detect (mock when REACT_APP_SA_API is empty).
REACT_APP_SA_USE_MOCK=
# Simulated latency (ms) for mock responses, so loading states are visible.
REACT_APP_SA_MOCK_LATENCY=180

# ── Customer Support API (the existing SignalR backend) ──
REACT_APP_SUPPORT_API=http://localhost:5150
# REACT_APP_SUPPORT_HUB=
# REACT_APP_SUPPORT_TOKEN=
