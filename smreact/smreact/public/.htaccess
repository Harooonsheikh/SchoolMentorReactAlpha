# Apache: serve the Launch-Setup SPA from the site root.
# Any request that is not a real file or folder falls back to index.html so
# client-side routing / page reloads work. Copied into build/ automatically.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
