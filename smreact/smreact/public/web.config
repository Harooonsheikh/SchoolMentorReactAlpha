<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: serve the Launch-Setup SPA from the site ROOT.
     Any URL that is not a real file/folder is rewritten to the root index.html
     so client-side routing / page reloads work. The /erp path is excluded so
     the ERP app (in the erp subfolder) handles its own routes.
     Copied into build/ automatically. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API proxy. The site is https, so the app cannot call the API at
             http://IP:4100 directly — a browser blocks an insecure request made
             from an https page (mixed content). It calls /api/... on this same
             origin instead and IIS forwards that to the API on localhost:4100.
             This rule already exists on the server; it lives here too because
             deploying build/ overwrites the server's web.config, and losing it
             would take every API call down.
             Needs Application Request Routing ("Enable proxy" on) + URL Rewrite
             installed on the server. -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/api/{R:1}" />
        </rule>
        <!-- Super-Admin service: {host}/SchoolMentorSuperAdminAPI/api/... -->
        <rule name="API Proxy (super admin)" stopProcessing="true">
          <match url="^SchoolMentorSuperAdminAPI/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SchoolMentorSuperAdminAPI/{R:1}" />
        </rule>
        <!-- Chain Management service (Network Head Office login/signup/OTP):
             {host}/SchoolmentorChainManagementAPI/api/...
             Without this the app has to call the API host directly, and that
             host returns no CORS headers for this origin — the browser blocks
             the network-login request before it is ever sent. -->
        <rule name="API Proxy (chain management)" stopProcessing="true">
          <match url="^SchoolmentorChainManagementAPI/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SchoolmentorChainManagementAPI/{R:1}" />
        </rule>
        <!-- Support chat SignalR hub (/hubs/support). Without this the socket
             handshake falls through to the SPA rule and comes back as
             index.html, so the connection never opens and Support silently
             stays in offline mode. ARR must have "Enable proxy" on and the
             WebSocket Protocol feature installed; the client already falls back
             to SSE / long-polling when WebSockets are unavailable. -->
        <rule name="SignalR Proxy (support hub)" stopProcessing="true">
          <match url="^hubs/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/hubs/{R:1}" />
        </rule>
        <!-- Support attachments are written to the API's own wwwroot, so they
             are served from the API host, not this origin. -->
        <rule name="Static Proxy (support attachments)" stopProcessing="true">
          <match url="^SupportAttachments/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SupportAttachments/{R:1}" />
        </rule>
        <!-- Not every endpoint sits under /api — a good number hang off the API
             root, e.g. /report-header/5, /get-subjects_byEmployeeID/1/2/3,
             /save-role, /delete-account-entry. Without this they fall through to
             the SPA rule below and come back as index.html, so the caller's
             res.json() throws and the screen renders empty (that is what broke
             Academics → Text Books).
             ADDING A NEW ROOT-LEVEL ENDPOINT? It must match here or it will 404
             into the SPA. Endpoints under /api need no change. -->
        <rule name="API Proxy (root endpoints)" stopProcessing="true">
          <match url="^((?:get|save|saveupdate|delete|assign)-[A-Za-z0-9_-]*|report-header)(/.*)?$" />
          <action type="Rewrite" url="http://localhost:4100/{R:0}" />
        </rule>
        <rule name="SPA Routes (root)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/hubs(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/erp(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/superadmin(/|$)" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
