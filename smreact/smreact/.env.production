# Read by `npm run build` only (Create React App). Values are baked into the
# bundle at build time — changing this file needs a rebuild + redeploy.

# API base for the live site: the ERP's own origin. IIS forwards /api/* from here
# to the API on localhost:4100 (see the "API Proxy" rule in public/web.config).
# Leave unset to fall back to PROD_URL in src/utils/apiConfig.js.
REACT_APP_API_BASE_URL=https://erp.schoolmentor.ai
