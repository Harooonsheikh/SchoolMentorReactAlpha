# Vite bakes these at build time — rebuild + redeploy after changes.
#
# ── Sandbox sites ──
#   ERP:   https://sandbox-erp.schoolmentor.ai/
#   Chain: https://sandbox-chain.schoolmentor.ai/
#   Admin: https://sandbox-admin.schoolmentor.ai/
#
# Same-origin API (empty bases) = IIS on this Chain host proxies to the API.
# Or set absolute sandbox-alphaapi URLs if there is no IIS proxy.

VITE_API_BASE_URL=/api
VITE_USE_MOCK=false

# ── Currently: SANDBOX ──
VITE_ERP_URL=https://sandbox-erp.schoolmentor.ai
# Same-origin on sandbox-chain (IIS proxies /SchoolmentorChainManagementAPI etc.)
VITE_CHAIN_API_BASE=
VITE_SUPERADMIN_API_BASE=
VITE_ERP_API_BASE=
VITE_MEDIA_BASE=https://sandbox-alphaapi.schoolmentor.ai

# If IIS proxy is NOT set up on sandbox-chain, use direct API instead:
# VITE_CHAIN_API_BASE=https://sandbox-alphaapi.schoolmentor.ai
# VITE_SUPERADMIN_API_BASE=https://sandbox-alphaapi.schoolmentor.ai
# VITE_ERP_API_BASE=https://sandbox-alphaapi.schoolmentor.ai

# ── Production ──
# VITE_USE_MOCK=false
# VITE_ERP_URL=https://erp.schoolmentor.ai
# VITE_CHAIN_API_BASE=
# VITE_SUPERADMIN_API_BASE=
# VITE_ERP_API_BASE=
# VITE_MEDIA_BASE=https://alphaapi.schoolmentor.ai
