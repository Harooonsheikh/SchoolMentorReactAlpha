# ─── Deployed environment (npm run build) ───
# Vite bakes these into the bundle at build time — changing a value needs a
# rebuild and redeploy.

# Point at the deployed API and turn the demo data off once it is live.
VITE_API_BASE_URL=/api
VITE_USE_MOCK=true

# Network Head Office accounts sign in on the ERP, which then hands the
# session over to this app (src/auth/handoff.js). Signing out here has to
# leave for the ERP login screen, so it needs the ERP's address.
# Leave this EMPTY only if this app should show its own /login screen.
VITE_ERP_URL=https://erp.schoolmentor.ai
