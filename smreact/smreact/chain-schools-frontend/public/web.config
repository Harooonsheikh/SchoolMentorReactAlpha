<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: serve the chain portal SPA (chain.schoolmentor.ai) from the site ROOT.

     This app uses BrowserRouter, so its routes are real paths (/dashboard,
     /school-payments, …) with no hash. IIS would look for a folder of that
     name and return 404, so anything that is not an actual file or folder is
     rewritten to index.html and React Router takes it from there.

     API calls: the app runs over HTTPS and calls its OWN origin with a relative
     path (/api/…, /SchoolmentorChainManagementAPI/…, /SchoolMentorSuperAdminAPI/…);
     IIS reverse-proxies each to the backend on this same server — no mixed
     content, no CORS — exactly like the ERP and Super-Admin apps.

     REQUIRES on the IIS site: Application Request Routing ("Enable proxy" ON) +
     URL Rewrite installed. The API (:4100) runs on this same server, so the
     localhost targets work. Vite copies public/ into dist/, so this ships with
     the build — deploy the whole dist/ folder, this file included. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Shared .NET API (branch directory, fee, etc.). -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/api/{R:1}" />
        </rule>
        <!-- Chain-Management API — network schools / requests / permissions. -->
        <rule name="API Proxy (chain management)" stopProcessing="true">
          <match url="^SchoolmentorChainManagementAPI/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SchoolmentorChainManagementAPI/{R:1}" />
        </rule>
        <!-- Super-Admin API — per-school module permissions. -->
        <rule name="API Proxy (super admin)" stopProcessing="true">
          <match url="^SchoolMentorSuperAdminAPI/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SchoolMentorSuperAdminAPI/{R:1}" />
        </rule>
        <!-- SPA fallback: any non-file/-folder route → index.html. The proxy
             rules above stop first; the API prefixes are excluded here too so a
             mistyped API path never comes back as index.html. -->
        <rule name="SPA Routes (chain portal)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/SchoolmentorChainManagementAPI(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/SchoolMentorSuperAdminAPI(/|$)" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
