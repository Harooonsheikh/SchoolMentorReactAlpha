# ─── Local development environment ───
# Base URL the front-end uses for API calls. "/api" makes the browser hit
# the same origin; the Vite dev proxy (vite.config.js) forwards it to the
# .NET backend. In production, set this to the deployed API URL.
VITE_API_BASE_URL=/api

# While true, API services return local mock data so the whole UI works
# before the .NET backend is connected. Flip to false once APIs are live.
VITE_USE_MOCK=true
